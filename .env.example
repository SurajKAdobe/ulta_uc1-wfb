LOG_LEVEL=debug

# S3 upload — action holds these, browser never sees them. A presign proxy service
# (S3_PRESIGN_URL) does the actual signing; this action only sends it these creds
# per request and forwards the resulting putUrl/getUrl to the frontend.

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGN_URL=

# Workflow Builder configuration — server-side only, never exposed to the frontend.
WORKFLOW_ID=0d3fb066-8ee7-409a-aedf-9664ad89a4a2
# The identity behind the OAuth Server-to-Server token below — must be that credential's
# own technical account id (see IMS_OAUTH_S2S_* further down), not a human user id, since
# run-workflow.adobe.io's x-gw-ims-user-id must match whoever the bearer token authenticates as.
IMS_USER_ID=
API_KEY=

# IMS OAuth Server-to-Server (client_credentials) technical account — actions/libs/imsAuth.js
# mints a fresh access token from these on every cold start and caches it in memory until
# shortly before it expires, so nobody has to hand-paste a short-lived user token here and
# redeploy every time it goes stale. Pulled from the Developer Console project's "OAuth
# Server-to-Server" credential — IMS_OAUTH_S2S_SCOPES is that credential's own JSON-array
# scopes export (e.g. '["openid","AdobeID",...]'); imsAuth.js comma-joins it for the token request.
IMS_OAUTH_S2S_CLIENT_ID=
IMS_OAUTH_S2S_CLIENT_SECRET=
IMS_OAUTH_S2S_ORG_ID=
IMS_OAUTH_S2S_SCOPES=

# Node IDs from the target Workflow Builder graph: the Merge Photoshop data node
# (takes the primary template), the 6 Input PSD nodes, and the 4 per-row Input
# Text nodes the CSV columns are fanned into (one execution per CSV row — see
# actions/libs/workflowPayload.js).
#
# WORKFLOW_ADDITIONAL_TEMPLATE_NODE_IDS order MUST match web-src's ADDITIONAL_TEMPLATES
# order (TemplateGrid.js), since they're zipped by index — not the port names' order
# in the Workflow Builder graph. Each id below maps to this named port on the
# ulta-datamerge-select-layer node:
#   1) node_1786970610638_9f26lkrp2_17_c82pwg  -> psdFile            (1-SKU 960x768)
#   2) node_1786970634894_q6l63xl6f_19_gbd7bt  -> psdFileOneSkuWide  (1-SKU 1500x896)
#   3) node_1786970650133_04bv3cul6_20_aqt5be  -> psdFileOneSkuSquare (1-SKU 1500x1500)
#   4) node_1786970622771_m74c6mnjf_18_e0pp6d  -> psdFileTwoSku      (2-SKU 960x768)
#   5) node_1786970673675_7n2ehltbw_21_9vruhf  -> psdFileTwoSkuWide  (2-SKU 1500x896)
#   6) node_1786970688160_lx043tcf9_22_9nqecn  -> psdFileTwoSkuSquare (2-SKU 1500x1500)
#
# The 4 per-row text node IDs correspond to these CSV columns (web-src/src/utils/csv.js
# WORKFLOW_ROW_COLUMNS — keep both in sync if the CSV schema or graph changes):
#   WORKFLOW_SKU_NODE_ID           <- "Sku's for Image"       (content-generation prompt)
#   WORKFLOW_FILENAME_NODE_ID      <- "Amplience Image Name"  (modify-file-attributes filename)
#   WORKFLOW_BACKGROUND_NODE_ID    <- "Firefly | Background"  (select-layer backgroundColorHex)
#   WORKFLOW_TEMPLATE_SIZE_NODE_ID <- "Firefly | Template"    (select-layer template)
WORKFLOW_TEMPLATE_NODE_ID=node-1787045677176-ekrydnsl1
WORKFLOW_ADDITIONAL_TEMPLATE_NODE_IDS=node_1786970610638_9f26lkrp2_17_c82pwg,node_1786970634894_q6l63xl6f_19_gbd7bt,node_1786970650133_04bv3cul6_20_aqt5be,node_1786970622771_m74c6mnjf_18_e0pp6d,node_1786970673675_7n2ehltbw_21_9vruhf,node_1786970688160_lx043tcf9_22_9nqecn
WORKFLOW_SKU_NODE_ID=node_1787052583438_lnx6d1bfe_21_4ddbba
WORKFLOW_FILENAME_NODE_ID=node_1787052624945_wv1pm970z_21_o4jcwc
WORKFLOW_BACKGROUND_NODE_ID=node_1787052687713_3n8c2dzcu_22_as4qkq
WORKFLOW_TEMPLATE_SIZE_NODE_ID=node_1787052764008_q4pz5bpv1_23_h24n6b

# SKU Personalization (actions/psd-manifest, actions/psd-composite) calls the Photoshop
# API using the same IMS_OAUTH_S2S_* credential + API_KEY above — no new env vars needed,
# just add "Photoshop API" to that credential's Developer Console project.
